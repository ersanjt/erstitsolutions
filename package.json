{
  "name": "erst-it-solutions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shell": "node scripts/shell.mjs",
    "check": "vite build && node scripts/check-seo.mjs",
    "lint": "biome lint",
    "validate": "html-validate \"dist/**/*.html\"",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:update": "playwright test tests/visual.spec.js --update-snapshots",
    "lighthouse": "npx -y @lhci/cli@0.15.1 autorun",
    "deploy": "node --env-file-if-exists=.env.deploy scripts/deploy.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@fontsource/unbounded": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.17.0",
    "linkedom": "^0.18.13",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27"
  }
}
