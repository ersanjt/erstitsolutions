AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddType image/svg+xml .svg
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Single host: www to apex.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

  # Keep /page instead of /page.html and /en/ instead of /en/index.html. Leave 404.html so the error document does not loop.
  RewriteCond %{THE_REQUEST} \s/+((?:en/|fa/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %1 !^404$ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /en and /fa without the trailing slash.
  RewriteRule ^(en|fa)$ /$1/ [R=301,L]

  # Geo IP chooses the language URL. 302 only, and never for crawlers:
  # a 301 or a bot redirect would collapse the three indexable versions.
  # These redirects depend on the visitor, so they carry NO_STORE: the
  # cPanel NGINX proxy cache would otherwise serve one visitor's redirect to all.
  # Türkiye stays on /, Iran and Afghanistan go to /fa/, every other
  # resolved country goes to /en/. A saved erst-lang choice wins.
  # Keep this map in sync with geoLang() in scripts/seo.mjs.
  RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|preview|headless|inspectiontool|mediapartners) [NC]
  RewriteRule ^ - [E=SKIP_GEO:1]
  RewriteCond %{REQUEST_URI} ^/(en|fa)(/|$) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(assets/|api/|src/|fonts/|favicon\.svg|sitemap\.xml|robots\.txt|llms\.txt|404\.html) [NC]
  RewriteRule ^ - [E=SKIP_GEO:1]

  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{HTTP_COOKIE} erst-lang=en [NC]
  RewriteRule ^(.*)$ /en/$1 [R=302,L,QSA,E=NO_STORE:1]
  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{HTTP_COOKIE} erst-lang=fa [NC]
  RewriteRule ^(.*)$ /fa/$1 [R=302,L,QSA,E=NO_STORE:1]
  RewriteCond %{HTTP_COOKIE} erst-lang=(tr|en|fa) [NC]
  RewriteRule ^ - [E=SKIP_GEO:1]

  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{HTTP:CF-IPCountry} ^(IR|AF)$ [NC]
  RewriteRule ^(.*)$ /fa/$1 [R=302,L,QSA,E=NO_STORE:1]
  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{ENV:GEOIP_COUNTRY_CODE} ^(IR|AF)$ [NC]
  RewriteRule ^(.*)$ /fa/$1 [R=302,L,QSA,E=NO_STORE:1]
  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{ENV:MM_COUNTRY_CODE} ^(IR|AF)$ [NC]
  RewriteRule ^(.*)$ /fa/$1 [R=302,L,QSA,E=NO_STORE:1]

  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{HTTP:CF-IPCountry} ^[A-Z]{2}$
  RewriteCond %{HTTP:CF-IPCountry} !^(TR|XX|T1)$ [NC]
  RewriteRule ^(.*)$ /en/$1 [R=302,L,QSA,E=NO_STORE:1]
  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{HTTP:CF-IPCountry} ^$
  RewriteCond %{ENV:GEOIP_COUNTRY_CODE} ^[A-Z]{2}$
  RewriteCond %{ENV:GEOIP_COUNTRY_CODE} !^(TR)$ [NC]
  RewriteRule ^(.*)$ /en/$1 [R=302,L,QSA,E=NO_STORE:1]
  RewriteCond %{ENV:SKIP_GEO} !^1$
  RewriteCond %{HTTP:CF-IPCountry} ^$
  RewriteCond %{ENV:GEOIP_COUNTRY_CODE} ^$
  RewriteCond %{ENV:MM_COUNTRY_CODE} ^[A-Z]{2}$
  RewriteCond %{ENV:MM_COUNTRY_CODE} !^(TR)$ [NC]
  RewriteRule ^(.*)$ /en/$1 [R=302,L,QSA,E=NO_STORE:1]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/en(/|$)" LANG_EN
  SetEnvIf Request_URI "^/fa(/|$)" LANG_FA
  Header set Content-Language "tr"
  Header set Content-Language "en" env=LANG_EN
  Header set Content-Language "fa" env=LANG_FA
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Browsers ignore this over plain HTTP, so it cannot lock anyone out; no includeSubDomains on purpose.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cache-Control "private, no-store" env=NO_STORE
  Header always merge Vary "Cookie" env=NO_STORE
  # HTML must revalidate; otherwise the cPanel NGINX cache keeps serving old pages after a deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    # The hash is the inline language-redirect script in the page head; npm run check fails if it changes.
    # cloudflareinsights is Cloudflare Web Analytics, injected at the edge.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-54iptiNgL5J+VTIfoeT29hQVxEykcq/e7xnKhpuddco=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
